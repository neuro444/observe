# Copy to .env and fill in real generated values — never commit the real .env.
#
# Generate each with:
#   openssl rand -base64 32   (PHOENIX_SECRET, PHOENIX_ADMIN_SECRET)
#   openssl rand -base64 24   (PHOENIX_DB_PASSWORD)
#   openssl rand -base64 18   (PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD)
#
# PHOENIX_ADMIN_SECRET must differ from PHOENIX_SECRET, be at least 32
# characters, and include at least one digit and one lowercase letter.

PHOENIX_DB_PASSWORD=
PHOENIX_SECRET=
PHOENIX_ADMIN_SECRET=
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=
