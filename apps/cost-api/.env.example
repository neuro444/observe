# Copy to .env and fill in real values — never commit the real .env.
# Every setting below has a working default except the two marked REQUIRED.

# --- Core ---
DATABASE_URL=postgresql://neuroheart:dev_only_change_in_real_deployment@127.0.0.1:5433/cost_ledger
COST_INGEST_SECRET=                          # REQUIRED — shared HMAC secret with the client repo's telemetry adapters

# --- Phase 1 daily-cost total ---
FIXED_SERVER_COST_MONTHLY_USD=28.85

# --- Nightly anomaly scan ---
ANOMALY_SCAN_HOUR_UTC=6
ANOMALY_LONG_CALL_SECONDS=600
ANOMALY_HIGH_TOKENS_PER_MINUTE=3000
ANOMALY_HIGH_COST_USD=1.00

# --- Weekly price-reconciliation job ---
PRICE_CHECK_DAY_OF_WEEK=mon
PRICE_CHECK_HOUR_UTC=5
PRICE_CHANGE_THRESHOLD_PERCENT=30            # team-confirmed; a change here is a config change, not a code change

# --- Price-review email notifications (off by default) ---
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=                             # REQUIRED if NOTIFICATIONS_ENABLED=true
PRICE_REVIEW_NOTIFY_EMAILS=                  # comma-separated, e.g. roshni@example.com,teammate@example.com
